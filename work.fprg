    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Do you want to play&quot;" newline="True"/>
            <declare name="Ans" type="String" array="False" size=""/>
            <input variable="Ans"/>
            <if expression="Ans = &quot;Y&quot;||Ans = &quot;Y&quot;||Ans = &quot;Yes&quot;||Ans = &quot;Yes&quot;||Ans = &quot;Yes&quot;">
                <then>
                    <output expression="&quot;48 has 10 factor. I thinking of one of them.&quot;" newline="True"/>
                    <output expression="&quot;Guess which factor I am thinking of.&quot;" newline="True"/>
                    <declare name="factor" type="Integer" array="False" size=""/>
                    <input variable="factor"/>
                    <while expression="factor!=16">
                        <output expression="&quot;You guess &amp; factor, but that's not it. try again&quot;" newline="True"/>
                        <input variable="factor"/>
                    </while>
                    <output expression="&quot; &quot;&amp;factor&amp;&quot; is absolutely correct! you are a factor superstar!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;maybe next time! Have a great day!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
